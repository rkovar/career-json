{
  "type": "object",
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "scope": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "output",
            "application",
            "role_family",
            "person"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "subject": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "atom",
            "strength",
            "preference"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": [
        "include",
        "reserve",
        "omit",
        "retract"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "made_by": {
      "type": "string",
      "enum": [
        "user",
        "system"
      ]
    },
    "on": {
      "type": "string",
      "minLength": 1
    },
    "source_refs": {
      "type": "array",
      "items": {
        "$ref": "career.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "supersedes": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    }
  },
  "required": [
    "decision_id",
    "scope",
    "subject",
    "action",
    "reason",
    "made_by",
    "on",
    "source_refs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "editorial-decision.schema.json"
}
