{
  "type": "object",
  "properties": {
    "selection_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "pack": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "brief": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "role": {
      "description": "Required when the pinned brief has role_id; must pin exactly data/roles/<role_id>.json. Omit for an untargeted brief. Enforced by semantic validation.",
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "candidate_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string",
            "minLength": 1
          },
          "disposition": {
            "type": "string",
            "enum": [
              "recommended",
              "reserve",
              "omit"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "contribution": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "replaces": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "evidence_id",
          "disposition",
          "reason",
          "contribution",
          "limitations",
          "replaces"
        ],
        "additionalProperties": false
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "created_by": {
      "type": "string",
      "enum": [
        "user",
        "system"
      ]
    },
    "review_status": {
      "type": "string",
      "enum": [
        "proposed",
        "accepted"
      ]
    },
    "review_source_refs": {
      "type": "array",
      "items": {
        "$ref": "career.schema.json#/$defs/sourceRef"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "supersedes": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "additionalProperties": false
    },
    "unavailable_priorities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "strength_readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "strength_id",
          "state"
        ],
        "properties": {
          "strength_id": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "available",
              "stale",
              "rejected",
              "unsupported",
              "withheld"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "selection_id",
    "pack",
    "brief",
    "decisions",
    "candidate_ids",
    "recommendations",
    "created_by",
    "review_status",
    "review_source_refs"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "selection-record.schema.json"
}
