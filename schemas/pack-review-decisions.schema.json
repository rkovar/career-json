{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Human career-pack review decisions",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "review_id",
    "proposal_sha256",
    "reviewed_by",
    "decisions",
    "omissions"
  ],
  "properties": {
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewed_by": {
      "type": "string",
      "minLength": 1
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "key",
          "fingerprint",
          "action",
          "publication",
          "note"
        ],
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "fingerprint": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "action": {
            "enum": [
              "accept",
              "correct",
              "unsure",
              "later"
            ],
            "type": "string"
          },
          "publication": {
            "enum": [
              "unchanged",
              "private",
              "external"
            ],
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "prompt",
          "answer"
        ],
        "additionalProperties": false,
        "properties": {
          "prompt": {
            "type": "string",
            "minLength": 1
          },
          "answer": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
