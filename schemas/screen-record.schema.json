{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "screen-record.schema.json",
  "title": "Recruiter Screen Record",
  "description": "Machine-readable verdict from recruiter-screen, written beside the prose screen so the outcome can be tracked and asserted on.",
  "type": "object",
  "required": [
    "artifact",
    "target_role",
    "screened",
    "verdict",
    "reason",
    "passes",
    "fix_in_document",
    "needs_new_evidence",
    "top_changes"
  ],
  "properties": {
    "artifact": {
      "type": "string",
      "minLength": 1
    },
    "prose_screen": {
      "type": "string"
    },
    "target_role": {
      "type": "string",
      "minLength": 1
    },
    "screened": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "advance",
        "borderline",
        "reject"
      ],
      "description": "Unhedged. reject is a successful run of the skill."
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "description": "The specific reason for the verdict, not a summary."
    },
    "better_fit_roles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "passes": {
      "type": "object",
      "required": [
        "screen",
        "hiring_manager"
      ],
      "properties": {
        "screen": {
          "type": "string",
          "enum": [
            "advance",
            "bin"
          ]
        },
        "screen_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hiring_manager": {
          "type": "string",
          "enum": [
            "convinced",
            "unconvinced"
          ]
        },
        "central_requirement_evidenced": {
          "type": "boolean"
        },
        "interview_attacks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "background_check_risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "fix_in_document": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "needs_new_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "top_changes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "run": {
      "$ref": "evaluation-record.schema.json#/$defs/run"
    },
    "context": {
      "type": "string",
      "enum": [
        "fresh",
        "shared"
      ],
      "description": "fresh: screened in a context that held only the artefact, the role profile and this skill. shared: screened in the context that generated the document, which is the model grading its own work. Decided 2026-09-06: a screen must be fresh."
    }
  },
  "additionalProperties": false
}
